{
  "name": "yourstruly-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build:api": "bun build apps/api/src/index.ts --outdir apps/api/dist --target bun",
    "build:web": "bun run --cwd apps/web build",
    "build": "bun run build:api && bun run build:web",
    "test": "bun test ./packages/**/test/*.test.ts ./apps/**/test/*.test.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3"
  }
}
